modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "cloudrun"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "pdf-fonts"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "topic-font-audit"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "country-brief-sweep"

[[workflows.workflow]]
name = "pdf-fonts"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash artifacts/workbench/scripts/validateFonts.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "topic-font-audit"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash artifacts/workbench/scripts/auditTopicFonts.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "country-brief-sweep"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash artifacts/workbench/scripts/verifyCountryBriefs.sh"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 22653
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
RELIEFWEB_APPNAME = "polestar-advisory-monitoring"
AIS_COLLECT_SECONDS = "180"
VESSEL_REGISTRY_ENABLED = "false"
AIS_PROVIDER = "aisstream"

[userenv.development]
