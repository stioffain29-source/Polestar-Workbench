    "scrape:energy": "tsx ./src/scrape-energy.ts",
    "scrape:fertiliser": "tsx ./src/scrape-fertiliser.ts",
    "scrape:fuel": "tsx ./src/scrape-fuel.ts",
    "scrape:prices": "tsx ./src/scrape-prices.ts",
