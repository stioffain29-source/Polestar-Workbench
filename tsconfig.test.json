{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["jest", "node"],
    "baseUrl": ".",
    "paths": {
      "@workspace/db": ["lib/db/src/index.ts"],
      "@workspace/db/schema": ["lib/db/src/schema/index.ts"],
      "@workspace/ingest": ["lib/ingest/src/index.ts"],
      "@workspace/strike-targets": ["lib/strike-targets/src/index.ts"],
      "@workspace/relevance": ["lib/relevance/src/index.ts"],
      "@workspace/api-zod": ["lib/api-zod/src/index.ts"],
      "@workspace/api-client-react": ["lib/api-client-react/src/index.ts"]
    }
  },
  "include": [
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "lib/**/src/**/*.ts"
  ]
}
