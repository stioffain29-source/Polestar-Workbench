# Local operator secrets (copy to .env.local — never commit .env.local).

# On Replit, manage via Tools → Secrets instead.



# Gates manual ingest, source editing, and backfill routes.

INGEST_ADMIN_TOKEN=



# OpenAI — powers country-report AI narratives and foreign headline translation.

# On Replit: add the OpenAI integration (auto-provisions AI_INTEGRATIONS_OPENAI_*).

# Locally: set OPENAI_API_KEY from https://platform.openai.com/api-keys

# OPENAI_API_KEY=sk-...

# Optional overrides (defaults: gpt-5.4 for prose, gpt-5-mini for translation):

# OPENAI_PROSE_MODEL=gpt-5.4

# OPENAI_FAST_MODEL=gpt-5-mini

# OPENAI_BASE_URL=https://api.openai.com/v1



# GDELT Conflict Events — additive precision layer over flashpoint incidents.

# Sign up at https://gdeltcloud.com for a free-tier API key.

# GDELT_CLOUD_API_KEY=

# Optional: set GDELT_ENRICH_ENABLED=false to switch off even when keyed.

# GDELT_CLOUD_API_BASE=https://gdeltcloud.com



# ReliefWeb (UN OCHA) — corroboration links + situational context reports.

# Request an approved appname at https://apidoc.reliefweb.int/parameters#appname

# (the v2 API returns 403 without one). This is an identifier, not a secret.

# RELIEFWEB_APPNAME=



# Liveuamap — optional live conflict-event overlay on the Geospatial Map.

# PAID API key from https://liveuamap.com (server-side proxy only; never sent to the browser).

# LIVEUAMAP_API_KEY=

# If keyed but the overlay stays unavailable, Liveuamap may be blocking this

# server's egress IP — contact Liveuamap support to allowlist the deployment IP.


