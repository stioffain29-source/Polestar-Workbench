# Local operator secrets (copy to .env.local — never commit .env.local).
# On Replit, manage via Tools → Secrets instead.

# Gates manual ingest, source editing, and backfill routes.
INGEST_ADMIN_TOKEN=

# OpenAI — powers country-report AI narratives and foreign headline translation.
# On Replit: add the OpenAI integration (auto-provisions AI_INTEGRATIONS_OPENAI_*).
# Locally: set OPENAI_API_KEY from https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# Optional overrides (defaults: gpt-5.4 for prose, gpt-5-mini for translation):
# OPENAI_PROSE_MODEL=gpt-5.4
# OPENAI_FAST_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
